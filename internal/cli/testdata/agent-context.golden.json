    {
      "path": "get",
      "short": "Read a GitHub resource through the daemon's cache",
      "args": "pr|issue|reviews|comments|checks|runs \u003cref\u003e",
      "flags": [
        {
          "name": "format",
          "type": "string",
          "default": "json",
          "usage": "output format: json|text"
        },
        {
          "name": "fresh",
          "type": "bool",
          "default": "false",
          "usage": "validate every part against GitHub, ignoring --max-age"
        },
        {
          "name": "max-age",
          "type": "duration",
          "default": "30s",
          "usage": "serve cached parts younger than this without any request"
        }
      ],
      "exit_codes": {
        "0": "ok",
        "1": "error",
        "2": "usage error"
      },
      "output_schema": {
        "format": "json",
        "fields": [
          "schema_version",
          "ref",
          "data",
          "meta"
        ],
        "note": "meta: from_cache, not_modified, via, fetched_at"
      }
    },
